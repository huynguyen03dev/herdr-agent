#!/usr/bin/env bash
# herdr-agent — thin helper for spawning Pi and sending text through Herdr.
# Usage:
#   herdr-agent spawn <label> [--role NAME] [--model X] [--provider X] [--thinking X]
#   herdr-agent task <pane-id> <text>
#
# --role NAME injects the role's system prompt from
#   ${HERDER_AGENT_HOME:-$HOME/herder-agent}/profiles/<NAME>_instruction.md
# (e.g. --role implementer|peer|reviewer|scout|proof_auditor). Model stays the
# caller's choice; the helper only handles profile injection.
#
# Default: deepseek-v4-flash / opencode-go / max
# The task command sends text unchanged, requires Pi to be ready (idle or done),
# submits long multiline prompts with paced text/Enter delivery, and returns only
# after Pi acknowledges the task. Recovery retries Enter only, never the payload.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  herdr-agent spawn <label> [--role NAME] [--model X] [--provider X] [--thinking X]
  herdr-agent task <pane-id> <task text>
EOF
}

profiles_dir() {
  echo "${HERDER_AGENT_HOME:-$HOME/herder-agent}/profiles"
}

fail_spawn() {
  local pane="$1"
  local message="$2"

  echo "$message" >&2
  herdr pane read "$pane" --source recent-unwrapped --lines 30 >&2 || true
  herdr agent get "$pane" >&2 || true
  herdr pane close "$pane" >/dev/null 2>&1 || true
  exit 1
}

wait_for_pi_ready() {
  local pane="$1"
  local deadline=$((SECONDS + 45))
  local info=""
  local agent=""
  local status=""

  while (( SECONDS < deadline )); do
    if info=$(herdr agent get "$pane" 2>/dev/null); then
      read -r agent status < <(python3 -c '
import json, sys
agent = json.load(sys.stdin)["result"]["agent"]
print(agent.get("agent", ""), agent.get("agent_status", ""))
' <<< "$info")

      if [[ "$agent" == "pi" && "$status" == "idle" ]]; then
        return 0
      fi
      if [[ "$status" == "done" ]]; then
        return 1
      fi
    fi
    sleep 0.25
  done

  return 1
}

agent_status() {
  local pane="$1"
  herdr agent get "$pane" | python3 -c '
import json, sys
print(json.load(sys.stdin)["result"]["agent"]["agent_status"])
'
}

# Reads "<agent_status> <state_change_seq>" for a pane in one herdr call.
# state_change_seq is Herdr's monotonic per-pane transition counter.
agent_state() {
  herdr agent get "$1" 2>/dev/null | python3 -c '
import json, sys
try:
    a = json.load(sys.stdin)["result"]["agent"]
except Exception:
    sys.exit(1)
print(a.get("agent_status", ""), a.get("state_change_seq", -1))
'
}

# Decide whether the agent actually consumed the task we just submitted, given
# the state_change_seq captured *before* sending ($seq0).
#
# A task is acknowledged when the agent enters `working`. But a trivial task can
# race idle->working->done between our polls, so catching `working` directly is
# unreliable. state_change_seq disambiguates: passing through working advances
# it by >=2 (e.g. idle->working->done), while a spontaneous done->idle decay --
# the one transition that happens WITHOUT our input -- advances it by exactly 1
# and never touches `working`. So: working/blocked now, or seq advanced >=2.
wait_for_task_start() {
  local pane="$1"
  local seq0="$2"
  local timeout_ms="${HERDR_TASK_START_TIMEOUT_MS:-15000}"
  local deadline=$(( SECONDS + (timeout_ms + 999) / 1000 ))
  local status="" seq=""

  while (( SECONDS < deadline )); do
    if read -r status seq < <(agent_state "$pane"); then
      if [[ "$status" == "working" || "$status" == "blocked" ]]; then
        return 0
      fi
      if [[ "$seq" =~ ^[0-9]+$ && "$seq0" =~ ^[0-9]+$ ]] && (( seq - seq0 >= 2 )); then
        return 0
      fi
    fi
    sleep 0.2
  done
  return 1
}

submit_task() {
  local pane="$1"
  local text="$2"
  local submit_delay="${HERDR_TASK_SUBMIT_DELAY_SECONDS:-0.25}"
  local status0="" seq0=""

  # Baseline the transition counter before sending so acknowledgment is judged
  # against this exact starting point.
  read -r status0 seq0 < <(agent_state "$pane")
  [[ "$seq0" =~ ^[0-9]+$ ]] || seq0=0

  # Keep payload delivery and submission separate. A long bracketed paste can
  # still be settling when an immediate Enter from `pane run` arrives.
  herdr pane send-text "$pane" "$text"
  sleep "$submit_delay"
  herdr pane send-keys "$pane" Enter

  if wait_for_task_start "$pane" "$seq0"; then
    return 0
  fi

  # The payload may be staged in Pi's editor with the first Enter lost. Retry
  # only Enter so recovery cannot duplicate the brief.
  herdr pane send-keys "$pane" Enter
  if wait_for_task_start "$pane" "$seq0"; then
    return 0
  fi

  echo "Pi did not acknowledge the staged task in pane $pane after an Enter-only retry" >&2
  herdr agent get "$pane" >&2 || true
  herdr pane read "$pane" --source recent-unwrapped --lines 40 >&2 || true
  return 1
}

cmd="${1:-}"
shift 2>/dev/null || true

MODEL="deepseek-v4-flash"
PROVIDER=""          # empty → inferred from MODEL at spawn time
THINKING="max"
THINKING_SET=0       # 1 once --thinking is passed explicitly

case "$cmd" in
  spawn)
    LABEL=""
    ROLE=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --role)      [[ $# -ge 2 ]] || { echo "Missing value for --role" >&2; exit 1; }; ROLE="$2"; shift 2 ;;
        --model)     [[ $# -ge 2 ]] || { echo "Missing value for --model" >&2; exit 1; }; MODEL="$2"; shift 2 ;;
        --provider)  [[ $# -ge 2 ]] || { echo "Missing value for --provider" >&2; exit 1; }; PROVIDER="$2"; shift 2 ;;
        --thinking)  [[ $# -ge 2 ]] || { echo "Missing value for --thinking" >&2; exit 1; }; THINKING="$2"; THINKING_SET=1; shift 2 ;;
        -*)          echo "Unknown flag: $1" >&2; exit 1 ;;
        *)           LABEL="$1"; shift ;;
      esac
    done

    if [ -z "$LABEL" ]; then
      usage
      exit 1
    fi

    # Resolve an optional role profile. The pane shell reads the file at run
    # time via $(cat ...), so only a short path is typed into the pane and the
    # profile contents never need escaping here.
    APPEND=""
    if [ -n "$ROLE" ]; then
      PDIR="$(profiles_dir)"
      ROLE_FILE="$PDIR/${ROLE}_instruction.md"
      if [ ! -f "$ROLE_FILE" ]; then
        echo "Unknown role '$ROLE'. Available roles:" >&2
        ls "$PDIR" 2>/dev/null | sed -n 's/_instruction\.md$//p' | grep -vx root >&2
        exit 1
      fi
      APPEND=" --append-system-prompt \"\$(cat '$ROLE_FILE')\""
    fi

    # Infer the provider from the model when it was not passed explicitly.
    if [ -z "$PROVIDER" ]; then
      case "$MODEL" in
        glm-*)  PROVIDER="zai-coding-cn" ;;   # glm-5.2
        *)      PROVIDER="opencode-go" ;;      # deepseek-v4-flash, mimo-v2.5-pro
      esac
    fi

    # Derive thinking from model + role unless the caller set it explicitly.
    # deepseek → max (auto); mimo → high ceiling; glm → high, medium for implementer.
    if [ "$THINKING_SET" -eq 0 ]; then
      case "$MODEL" in
        glm-*)  [ "$ROLE" = "implementer" ] && THINKING="medium" || THINKING="high" ;;
        mimo-*) THINKING="high" ;;
        *)      THINKING="max" ;;              # deepseek-v4-flash
      esac
    fi
    # mimo has no max tier — clamp even an explicit request.
    case "$MODEL" in mimo-*) [ "$THINKING" = "max" ] && THINKING="high" ;; esac

    # Create tab, get pane-id
    PANE=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null | python3 -c "
import json, sys
print(json.load(sys.stdin)['result']['root_pane']['pane_id'])
")
    if [ -z "$PANE" ]; then
      echo "Failed to create tab" >&2
      exit 1
    fi

    # Rename
    herdr pane rename "$PANE" "$LABEL" >/dev/null 2>&1

    # Launch Pi, then wait until Herdr identifies this pane as an idle Pi agent.
    # Checking identity avoids mistaking the initial idle shell for a ready agent.
    herdr pane run "$PANE" "pi --minimal-tui --offline --provider $PROVIDER --model $MODEL --thinking $THINKING$APPEND" >/dev/null 2>&1

    if ! wait_for_pi_ready "$PANE"; then
      fail_spawn "$PANE" "Pi did not become ready in pane $PANE"
    fi

    # Also set the AGENT name (not just the pane title) so event-driven
    # plugins (e.g. attention-broker) can name which co-worker changed state
    # instead of collapsing every pi seat to "pi". Must run AFTER pi is ready:
    # renaming a pane with no live agent blocks. herdr enforces lowercase-start,
    # [a-z0-9_-], 1-32 chars — so sanitize first and skip if it cannot map.
    AGENT_NAME=$(printf '%s' "$LABEL" \
      | tr '[:upper:]' '[:lower:]' \
      | tr -c 'a-z0-9_-' '-' \
      | sed -E 's/^[^a-z]+//; s/-+/-/g; s/-$//' \
      | cut -c1-32)
    [ -n "$AGENT_NAME" ] && herdr agent rename "$PANE" "$AGENT_NAME" >/dev/null 2>&1

    # Report metadata: show role (if any) + agent + model on the pane
    # Report metadata: keep `agent` short ("pi") so the sidebar's state line
    # (idle · pi · reviewer) never truncates. Role/model/effort go to custom
    # tokens so config.toml can split them across sidebar lines.
    # Role goes next to state+agent on the second line.
    # Model+effort go on a third line as separate tokens.
    herdr pane report-metadata "$PANE" \
      --source herdr-agent \
      --display-agent "pi" \
      --title "$LABEL" \
      --token role="${ROLE:-}" \
      --token model="$MODEL" \
      --token effort="$THINKING" \
      --ttl-ms 86400000 >/dev/null 2>&1 || true

    echo "$PANE"
    ;;

  task)
    PANE="${1:-}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    TEXT="${*:-}"

    if [ -z "$PANE" ] || [ -z "$TEXT" ]; then
      usage
      exit 1
    fi

    STATUS=$(agent_status "$PANE")
    if [[ "$STATUS" != "idle" && "$STATUS" != "done" ]]; then
      echo "Agent $PANE is $STATUS; refusing to send a task unless it is ready (idle or done)" >&2
      exit 1
    fi

    submit_task "$PANE" "$TEXT"
    ;;

  *)
    usage
    exit 1
    ;;
esac
