#!/usr/bin/env bash
# herdr-agent — thin helper for spawning Pi and sending text through Herdr.
# Usage:
#   herdr-agent spawn <label> [--role NAME] [--model X] [--provider X] [--thinking X]
#   herdr-agent task <pane-id> <text>
#
# --role NAME injects the role's system prompt from
#   ${HERDER_AGENT_HOME:-$HOME/herder-agent}/profiles/<NAME>_instruction.md
# Only `peer` and `lead` are spawnable. `supervisor` is refused: the Supervisor
# seat is opened manually by the Human and never spawned. `lead` IS spawnable:
# it exists for ordered succession (an old Lead, or the Supervisor on the
# Human's behalf, spawns a successor Lead, briefs it, then the old seat closes).
#
# Model, provider, and thinking tier are resolved from role + model unless
# overridden: peer -> deepseek-v4-flash (cheap execution; escalate per-task
# with --model glm-5.2), lead -> glm-5.2 (director fallback needs strength).
#
# The task command sends text unchanged, requires Pi to be ready (idle or done),
# submits long multiline prompts with paced text/Enter delivery, and returns only
# after Pi acknowledges the task. Recovery retries Enter only, never the payload.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  herdr-agent spawn <label> [--role NAME] [--model X] [--provider X] [--thinking X]
  herdr-agent task <pane-id> <task text>
EOF
}

profiles_dir() {
  echo "${HERDER_AGENT_HOME:-$HOME/herder-agent}/profiles"
}

fail_spawn() {
  local pane="$1"
  local message="$2"

  echo "$message" >&2
  herdr pane read "$pane" --source recent-unwrapped --lines 30 >&2 || true
  herdr agent get "$pane" >&2 || true
  herdr pane close "$pane" >/dev/null 2>&1 || true
  exit 1
}

# Ready means: a live pi owns the pane and is accepting input. `done` counts as
# ready for the same reason `task` accepts it — pi can boot straight into a
# completed first turn. A pi that failed to launch has no live agent at all, so
# it never satisfies the `agent == pi` test and falls out via the deadline.
wait_for_pi_ready() {
  local pane="$1"
  local deadline=$((SECONDS + 45))
  local info=""
  local agent=""
  local status=""

  while (( SECONDS < deadline )); do
    if info=$(herdr agent get "$pane" 2>/dev/null); then
      read -r agent status < <(python3 -c '
import json, sys
agent = json.load(sys.stdin)["result"]["agent"]
print(agent.get("agent", ""), agent.get("agent_status", ""))
' <<< "$info") || true

      if [[ "$agent" == "pi" && ( "$status" == "idle" || "$status" == "done" ) ]]; then
        return 0
      fi
    fi
    sleep 0.25
  done

  return 1
}

agent_status() {
  local pane="$1"
  herdr agent get "$pane" | python3 -c '
import json, sys
print(json.load(sys.stdin)["result"]["agent"]["agent_status"])
'
}

# Reads "<agent_status> <state_change_seq>" for a pane in one herdr call.
# state_change_seq is Herdr's monotonic per-pane transition counter.
agent_state() {
  herdr agent get "$1" 2>/dev/null | python3 -c '
import json, sys
try:
    a = json.load(sys.stdin)["result"]["agent"]
except Exception:
    sys.exit(1)
print(a.get("agent_status", ""), a.get("state_change_seq", -1))
'
}

# Decide whether the agent actually consumed the task we just submitted, given
# the state_change_seq captured *before* sending ($seq0).
#
# A task is acknowledged when the agent enters `working`. But a trivial task can
# race idle->working->done between our polls, so catching `working` directly is
# unreliable. state_change_seq disambiguates: passing through working advances
# it by >=2 (e.g. idle->working->done), while a spontaneous done->idle decay --
# the one transition that happens WITHOUT our input -- advances it by exactly 1
# and never touches `working`. So: working/blocked now, or seq advanced >=2.
wait_for_task_start() {
  local pane="$1"
  local seq0="$2"
  local timeout_ms="${HERDR_TASK_START_TIMEOUT_MS:-15000}"
  local deadline=$(( SECONDS + (timeout_ms + 999) / 1000 ))
  local status="" seq=""

  while (( SECONDS < deadline )); do
    if read -r status seq < <(agent_state "$pane"); then
      if [[ "$status" == "working" || "$status" == "blocked" ]]; then
        return 0
      fi
      if [[ "$seq" =~ ^[0-9]+$ && "$seq0" =~ ^[0-9]+$ ]] && (( seq - seq0 >= 2 )); then
        return 0
      fi
    fi
    sleep 0.2
  done
  return 1
}

submit_task() {
  local pane="$1"
  local text="$2"
  local submit_delay="${HERDR_TASK_SUBMIT_DELAY_SECONDS:-0.25}"
  local status0="" seq0=""

  # Baseline the transition counter before sending so acknowledgment is judged
  # against this exact starting point.
  # `|| true` is load-bearing: a standalone `read` from a failed process
  # substitution returns non-zero and `set -e` would abort submit_task with no
  # message at all.
  read -r status0 seq0 < <(agent_state "$pane") || true
  [[ "${seq0:-}" =~ ^[0-9]+$ ]] || seq0=0

  # Keep payload delivery and submission separate. A long bracketed paste can
  # still be settling when an immediate Enter from `pane run` arrives.
  herdr pane send-text "$pane" "$text"
  sleep "$submit_delay"
  herdr pane send-keys "$pane" Enter

  if wait_for_task_start "$pane" "$seq0"; then
    return 0
  fi

  # The payload may be staged in Pi's editor with the first Enter lost. Retry
  # only Enter so recovery cannot duplicate the brief.
  herdr pane send-keys "$pane" Enter
  if wait_for_task_start "$pane" "$seq0"; then
    return 0
  fi

  echo "Pi did not acknowledge the staged task in pane $pane after an Enter-only retry" >&2
  herdr agent get "$pane" >&2 || true
  herdr pane read "$pane" --source recent-unwrapped --lines 40 >&2 || true
  return 1
}

cmd="${1:-}"
shift 2>/dev/null || true

MODEL=""             # empty -> resolved from role below unless --model passed
PROVIDER=""          # empty → inferred from MODEL at spawn time
THINKING="max"
THINKING_SET=0       # 1 once --thinking is passed explicitly

case "$cmd" in
  spawn)
    LABEL=""
    ROLE=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --role)      [[ $# -ge 2 ]] || { echo "Missing value for --role" >&2; exit 1; }; ROLE="$2"; shift 2 ;;
        --model)     [[ $# -ge 2 ]] || { echo "Missing value for --model" >&2; exit 1; }; MODEL="$2"; shift 2 ;;
        --provider)  [[ $# -ge 2 ]] || { echo "Missing value for --provider" >&2; exit 1; }; PROVIDER="$2"; shift 2 ;;
        --thinking)  [[ $# -ge 2 ]] || { echo "Missing value for --thinking" >&2; exit 1; }; THINKING="$2"; THINKING_SET=1; shift 2 ;;
        -*)          echo "Unknown flag: $1" >&2; exit 1 ;;
        *)           LABEL="$1"; shift ;;
      esac
    done

    if [ -z "$LABEL" ]; then
      usage
      exit 1
    fi

    # Resolve an optional role profile. The pane shell reads the file
    # at run time via $(cat ...) and injects it through --append-system-prompt.
    APPEND=""
    if [ -n "$ROLE" ]; then
      PDIR="$(profiles_dir)"
      # Peer and Lead are the only spawnable roles. Supervisor is opened
      # manually by the Human; a spawned Supervisor would answer to whoever
      # spawned it, not to the Human. `root` is a legacy name that no longer
      # exists. Path fragments never name a real profile file.
      case "$ROLE" in
        peer|lead)
          ;;
        supervisor|supervisor_instruction)
          echo "Refusing --role '$ROLE': the Supervisor seat is opened manually by the Human, never spawned." >&2
          exit 1
          ;;
        root|root_instruction|*/*|*..*)
          echo "Refusing --role '$ROLE'." >&2
          exit 1
          ;;
      esac
      ROLE_FILE="$PDIR/${ROLE}_instruction.md"
      if [ ! -f "$ROLE_FILE" ]; then
        echo "Unknown role '$ROLE'. Available roles:" >&2
        ls "$PDIR" 2>/dev/null | sed -n 's/_instruction\.md$//p' | grep -vx root >&2
        exit 1
      fi
      APPEND=" --append-system-prompt \"\$(cat '$ROLE_FILE')\""
    fi

    # Resolve the default model from the role when --model wasn't passed.
    # lead -> glm-5.2 (a spawned director fallback needs the strongest
    #   co-worker model); peer / no role -> deepseek-v4-flash (cheap execution
    #   and terrain-mapping; the Lead escalates per-task with --model glm-5.2).
    if [ -z "$MODEL" ]; then
      case "$ROLE" in
        lead)                                    MODEL="glm-5.2" ;;
        *)                                       MODEL="deepseek-v4-flash" ;;
      esac
    fi

    # Infer the provider from the model when not passed explicitly.
    if [ -z "$PROVIDER" ]; then
      case "$MODEL" in
        glm-*)                 PROVIDER="zai" ;;                # glm-5.2
        *)                     PROVIDER="opencode-go" ;;        # deepseek-v4-flash
      esac
    fi

    # Derive thinking from model unless the caller set it explicitly.
    if [ "$THINKING_SET" -eq 0 ]; then
      case "$MODEL" in
        glm-*)  THINKING="high" ;;
        *)      THINKING="max" ;;              # deepseek-v4-flash
      esac
    fi

    # Preflight the room. Without this, `set -u` aborts on an unbound
    # HERDR_WORKSPACE_ID with a bash error instead of saying what is wrong.
    if [ "${HERDR_ENV:-}" != "1" ] || [ -z "${HERDR_WORKSPACE_ID:-}" ]; then
      echo "Not inside a Herdr room (HERDR_ENV=1 and HERDR_WORKSPACE_ID required)." >&2
      exit 1
    fi

    # Create tab, get pane-id
    PANE=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null | python3 -c "
import json, sys
print(json.load(sys.stdin)['result']['root_pane']['pane_id'])
")
    if [ -z "$PANE" ]; then
      echo "Failed to create tab" >&2
      exit 1
    fi

    # Rename
    herdr pane rename "$PANE" "$LABEL" >/dev/null 2>&1

    # Launch the agent. pi uses --provider/--model/--thinking + --append-system-prompt
    # for role injection. Runs from the current cwd so the agent operates
    # in the project directory.
    herdr pane run "$PANE" "pi --minimal-tui --offline --provider $PROVIDER --model $MODEL --thinking $THINKING$APPEND" >/dev/null 2>&1
    if ! wait_for_pi_ready "$PANE"; then
      fail_spawn "$PANE" "Pi did not become ready in pane $PANE"
    fi

    # Also set the AGENT name (not just the pane title) so event-driven
    # plugins (e.g. attention-broker) can name which co-worker changed state
    # instead of collapsing every pi seat to "pi". Must run AFTER pi is ready:
    # renaming a pane with no live agent blocks. herdr enforces lowercase-start,
    # [a-z0-9_-], 1-32 chars — so sanitize first and skip if it cannot map.
    AGENT_NAME=$(printf '%s' "$LABEL" \
      | tr '[:upper:]' '[:lower:]' \
      | tr -c 'a-z0-9_-' '-' \
      | sed -E 's/^[^a-z]+//; s/-+/-/g; s/-$//' \
      | cut -c1-32)

    # Agent names are unique across ALL workspaces, so a second room spawning
    # the same label loses the name — and the broker then wakes root with
    # "pi:done" instead of naming the seat. Fall back to a workspace-qualified
    # name, and never swallow the outcome: an unnamed seat is a supervision
    # problem, not a cosmetic one.
    if [ -n "$AGENT_NAME" ]; then
      if ! herdr agent rename "$PANE" "$AGENT_NAME" >/dev/null 2>&1; then
        QUALIFIED=$(printf '%s-%s' "$(printf '%s' "$AGENT_NAME" | cut -c1-24)" "$HERDR_WORKSPACE_ID")
        if herdr agent rename "$PANE" "$QUALIFIED" >/dev/null 2>&1; then
          AGENT_NAME="$QUALIFIED"
        else
          echo "warning: could not name agent in $PANE ('$AGENT_NAME' and '$QUALIFIED' both rejected);" \
               "attention wakes will identify it only as 'pi'" >&2
          AGENT_NAME=""
        fi
      fi
    fi

    # Report metadata: keep `agent` short so the sidebar's state line never
    # truncates. For pi the display agent is "pi". Role, model, effort, and
    # the sanitized name go to custom $-tokens for the sidebar rows defined
    # in herdr-config.toml.
    #
    # Pretty-print the model name for the sidebar: strip version dashes for a
    # compact display (e.g. deepseek-v4-flash -> deepseek v4 flash).
    #
    # The TTL is deliberately shorter than a day: herdr reuses pane IDs within
    # minutes, and metadata that outlives its seat gets shown against whatever
    # occupies the pane next (a dead seat's role/model was observed bleeding
    # onto a live session this way).
    DISPLAY_MODEL=$(printf '%s' "$MODEL" \
      | sed -E 's/-/ /g')
    herdr pane report-metadata "$PANE" \
      --source herdr-agent \
      --display-agent "pi" \
      --title "$LABEL" \
      --token name="${AGENT_NAME:-}" \
      --token role="${ROLE:-}" \
      --token model="$DISPLAY_MODEL" \
      --token effort="$THINKING" \
      --ttl-ms "${HERDR_METADATA_TTL_MS:-7200000}" >/dev/null 2>&1 || true

    echo "$PANE"
    ;;

  task)
    PANE="${1:-}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    TEXT="${*:-}"

    if [ -z "$PANE" ] || [ -z "$TEXT" ]; then
      usage
      exit 1
    fi

    STATUS=$(agent_status "$PANE")
    if [[ "$STATUS" != "idle" && "$STATUS" != "done" ]]; then
      echo "Agent $PANE is $STATUS; refusing to send a task unless it is ready (idle or done)" >&2
      exit 1
    fi

    submit_task "$PANE" "$TEXT"
    ;;

  *)
    usage
    exit 1
    ;;
esac
